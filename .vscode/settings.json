{
  // Open this folder through the WSL remote ("WSL: Connect to WSL", or `code .`
  // from the WSL shell) so rust-analyzer runs against the Linux toolchain in
  // rust-toolchain.toml. `alloc::je` and `alloc::hardened` are gated on
  // `not(target_env = "msvc")`, which a native linux-gnu host satisfies with no
  // toolchain override — the mingw-w64 workaround this file used to carry is
  // only needed when analyzing from a Windows host.
  // `alloc::je` and `alloc::hardened` each define a #[global_allocator], so
  // `hardened` is gated on `not(feature = "jemalloc")` and the two can never be
  // active together. rust-analyzer resolves one cfg set, so whichever backend is
  // not selected reports "not included in any crates". To work on
  // alloc/hardened.rs, swap this line for ["hardened_malloc"] and restart the
  // server; note "all" does NOT cover both, since --all-features enables
  // jemalloc and thereby excludes hardened.
  "rust-analyzer.cargo.features": ["jemalloc_stats", "jemalloc_conf"],

  // Match `just check-rust`, so editor diagnostics are the ones CI enforces.
  // Do NOT add "--all-targets" to check.extraArgs: rust-analyzer already passes
  // it (rust-analyzer.check.allTargets defaults to true) and cargo rejects the
  // flag twice with "cannot be used multiple times", which kills flycheck.
  "rust-analyzer.check.command": "clippy",

  // Keep rust-analyzer out of ./target; otherwise its checks take the same
  // cargo lock as a terminal build and the two block each other. Worth it here
  // because the tree lives on /mnt/d, where crossing the WSL filesystem
  // boundary makes a redundant rebuild expensive.
  "rust-analyzer.cargo.targetDir": true,

  // The tree was just normalized to LF; keep editor saves from reintroducing
  // CRLF now that it is edited from both Windows and WSL. .gitattributes is the
  // real enforcement — this only stops the editor fighting it.
  "files.eol": "\n",

  // ---------------------------------------------------------------------------
  // Formatting.
  //
  // Format on save is on globally; each language below names its own formatter,
  // so VS Code picks the right one from the file type and there is nothing to
  // switch by hand. A language with no block here falls back to
  // editor.defaultFormatter, which is deliberately left unset: an unconfigured
  // file type should prompt rather than be reformatted by an arbitrary
  // extension.
  // ---------------------------------------------------------------------------
  "editor.formatOnSave": true,

  // Only act on imports where the language server actually manages them (Go,
  // Python). "explicit" means on an invoked save, not on autosave.
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },

  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },

  // gopls runs gofmt; golangci-lint in .golangci.yml stays the source of truth
  // for lint. gofmt is not configurable, so there is no width/indent setting.
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[go.mod]": {
    "editor.defaultFormatter": "golang.go"
  },
  "[go.sum]": {
    "editor.defaultFormatter": "golang.go"
  },

  // Prettier for the whole web/config family.
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[less]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // YAML has its own extension with schema validation; it formats via Prettier
  // internally, so this avoids the two extensions competing for the same files.
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },

  // Ruff covers both format and import sorting, replacing black + isort.
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },

  // clang-format. It reads a .clang-format file from the nearest parent
  // directory; with none present it uses the fallback style below.
  "[c]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
  "[cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_fallbackStyle": "LLVM",

  // TOML: this repo has several (Cargo.toml, deny.toml, rustfmt.toml,
  // phantom-example.toml), so it is worth pinning rather than leaving to prompt.
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml" },

  "[shellscript]": { "editor.defaultFormatter": "foxundermoon.shell-format" }
}
